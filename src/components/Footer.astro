---
import { business } from '../data/business';
import { consultationsNavChildren } from '../data/nav';

const year = new Date().getFullYear();
const mapsHref =
  'https://www.openstreetmap.org/?mlat=48.69450&mlon=6.16998#map=17/48.69450/6.16998&layers=T';

const footerNav = [
  { name: 'Accueil', href: '/' },
  ...consultationsNavChildren,
  { name: 'Informations pratiques', href: '/informations-pratiques/' },
  { name: 'Parcours professionnel', href: '/florent-simon-psychologue/' },
] satisfies { name: string; href: string }[];
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <p class="site-footer-wordmark">Florent Simon</p>
      <p class="site-footer-desc">
        Psychologue clinicien à Nancy. J’accompagne enfants, adolescents et adultes dans un cadre
        bienveillant et confidentiel, pour cheminer ensemble vers un mieux-être.
      </p>
    </div>

    <div class="site-footer-cols">
      <section class="site-footer-col" aria-label="Coordonnées du cabinet">
        <p class="site-footer-col-title">Cabinet</p>
        <address class="site-footer-address not-italic">
          <a
            href={mapsHref}
            class="site-footer-link"
            rel="noopener noreferrer"
            target="_blank"
          >
            {business.streetAddress}, {business.postalCode} {business.addressLocality}
          </a>
          <a href={`tel:${business.phoneE164}`} class="site-footer-link">{business.phoneDisplay}</a>
          <a href={`mailto:${business.email}`} class="site-footer-link">{business.email}</a>
        </address>
      </section>

      <nav class="site-footer-col" aria-label="Plan du site">
        <p class="site-footer-col-title">Navigation</p>
        {footerNav.map((item) => (
          <a href={item.href} class="site-footer-link">{item.name}</a>
        ))}
      </nav>

      <section class="site-footer-col" aria-label="Informations légales">
        <p class="site-footer-col-title">Légal</p>
        <a href="/mentions-legales/" class="site-footer-link">Mentions légales</a>
      </section>
    </div>
  </div>

  <div class="site-footer-bottom">
    <p class="site-footer-copyright">
      © 2018–{year} Florent Simon — Psychologue clinicien. Tous droits réservés.
    </p>
    <a
      href="https://nicodev.fr/"
      class="site-footer-credit"
      target="_blank"
      rel="noopener noreferrer">Création de sites internet pour psychologues</a
    >
  </div>
</footer>
