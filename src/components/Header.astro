---
import { mainNav } from '../data/nav';

interface Props {
  currentPath: string;
}

function normalizePath(path: string) {
  if (path === '/' || path === '') return '/';
  return path.endsWith('/') ? path : `${path}/`;
}

const { currentPath } = Astro.props;
const path = normalizePath(currentPath);
---

<header>
  <div class="home-top-color-bar mb-4 h-6 bg-yellow"></div>
  <div class="home-top-color-bar mb-4 h-6 bg-green"></div>
  <div class="home-top-color-bar h-6 bg-yellow"></div>
  <div class="mx-auto w-full max-w-6xl px-2 lg:px-0">
    <nav
      class="relative flex flex-wrap items-center justify-between py-0 max-lg:min-h-[4.5rem] max-lg:content-center lg:min-h-0 lg:content-normal lg:py-6"
    >
    <div class="flex w-full items-center justify-between gap-3 lg:hidden">
      <a
        href="/"
        class="site-mobile-brand flex min-h-11 min-w-0 flex-1 items-center text-left text-base font-semibold leading-none text-black no-underline hover:text-grey-darkest"
      >
        Florent Simon
      </a>
      <div class="js-nav-container flex shrink-0 items-center">
        <button
          type="button"
          class="js-nav-trigger flex min-h-11 min-w-11 items-center justify-center rounded border-2 border-teal-light p-2.5 text-black hover:border-white hover:text-grey-darkest"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Ouvrir le menu"
        >
          <svg
            class="nav-icon-burger h-8 w-8 shrink-0 fill-current"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            ><title>Menu</title><path
              d="M3 5h18v2.5H3V5zm0 5.75h18v2.5H3v-2.5zm0 5.75h18V19H3v-2.5z"></path></svg
          >
          <svg
            class="nav-icon-close h-8 w-8 shrink-0 stroke-current"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            stroke-width="2.25"
            stroke-linecap="round"
            aria-hidden="true"
            ><title>Fermer</title><path d="M6 6l12 12M18 6L6 18"></path></svg
          >
        </button>
      </div>
    </div>
    <div class="block w-full grow lg:flex lg:w-auto lg:items-center">
      <div id="site-nav" class="js-nav w-full lg:relative lg:right-0 lg:top-0 lg:flex lg:grow lg:justify-end">
        <ul>
          {
            mainNav.map((item) => {
              const itemPath = normalizePath(new URL(item.href, Astro.site).pathname);
              const isActive = path === itemPath;
              return (
                <li
                  class:list={[
                    'custom-menu-link mt-4 block border-1 border-grey-darkest p-2 text-black lg:mt-0 lg:inline-block',
                    isActive
                      ? 'bg-green'
                      : 'bg-yellow no-underline hover:bg-green',
                  ]}
                >
                  <a
                    href={item.href}
                    class="block no-underline text-inherit"
                    aria-current={isActive ? 'page' : undefined}>
                    {item.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var t = document.querySelector('.js-nav-trigger');
    var n = document.querySelector('.js-nav');
    if (!t || !n) return;

    function setOpen(isOpen) {
      n.classList.toggle('active', isOpen);
      t.classList.toggle('active', isOpen);
      t.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      t.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
    }

    t.addEventListener('click', function () {
      setOpen(!n.classList.contains('active'));
    });

    n.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        setOpen(false);
      });
    });
  })();
</script>
