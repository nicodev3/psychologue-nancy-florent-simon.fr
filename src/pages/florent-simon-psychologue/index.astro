---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';

const title = 'Florent Simon : parcours, diplômes — psychologue à Nancy';
const description = `Diplômes (Université de Lorraine), expérience CMPP / AEMO / enseignement. Psychologue à Nancy — ${business.streetAddress}. ${business.phoneDisplay}.`;
---

<BaseLayout title={title} description={description}>
  <div class="inner-page-wide">
    <header class="inner-page-header">
      <p class="inner-page-label">À propos</p>
      <h1 class="inner-page-h1">Florent Simon, psychologue</h1>
    </header>

    <div class="inner-grid-2">
      <div class="inner-stack">
        <div class="inner-card">
          <h2 class="inner-card-title">Formation et diplômes</h2>
          <div class="inner-card-body">
            <ul class="inner-styled-list">
              <li>Licence de Psychologie - Université de Lorraine</li>
              <li>Master de Psychologie Clinique - Université de Lorraine</li>
              <li>Doctorat de Psychologie Clinique - Université de Lorraine</li>
            </ul>
          </div>
        </div>

        <div class="inner-card">
          <h2 class="inner-card-title">Expérience professionnelle</h2>
          <div class="inner-card-body">
            <p>
              Florent Simon occupe actuellement plusieurs fonctions qui rendent compte de sa spécialisation
              en psychologie de l'enfant et de l'adolescent :
            </p>
            <ul class="inner-styled-list">
              <li>Psychologue clinicien en Centre-Médico-Psycho-Pédagogique (CMPP)</li>
              <li>
                Psychologue clinicien dans le champ de la Protection de l'Enfance (AEMO)
              </li>
              <li>
                Enseigement de la psychologie à l'Université auprès des étudiants de Licence et de Master
                (Université de Lorraine)
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div>
        <div class="inner-card">
          <h2 class="inner-card-title">Règlementation</h2>
          <div class="inner-card-body">
            <h2>N° ADELI</h2>
            <p>549310506</p>
            <p>
              Le titre de psychologue est protégé et réglementé par l'Agence Régionale de Santé (ARS) à
              partir du numéro ADELI
            </p>
            <h2>N° SIRET</h2>
            <p>844 745 646 00019</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
