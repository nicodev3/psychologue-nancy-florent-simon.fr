---
import { business } from '../data/business';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Florent Simon, psychologue à Nancy';
const description = `Florent Simon, psychologue psychothérapeute à Nancy — enfants, adolescents, adultes. Cabinet ${business.streetAddress}. ${business.phoneDisplay}.`;
---

<BaseLayout title={title} description={description}>
  <div class="flex flex-wrap justify-between">
    <main
      class="custom-home-main mb-2 w-full rounded-lg border border-grey-darkest bg-white p-4 lg:mb-0 lg:w-3/5 lg:p-12"
    >
      <header class="text-center">
        <div class="mb-10 text-base sm:text-lg md:text-xl">
          Florent SIMON <br /><br />
          <h1 class="mx-auto max-w-xl text-base uppercase text-center leading-snug">
            psychologue<br />
            psychothérapeute<br />
            à Nancy
          </h1>
        </div>
      </header>
      <div class="text-center">
        <p class="mb-6">
          Je reçois les enfants, les adolescents et les adultes en consultations psychologiques à mon
          cabinet libéral.
        </p>
        <p class="mb-6">
          Il se situe{' '}
          <a
            href="https://www.openstreetmap.org/?mlat=48.69450&mlon=6.16998#map=17/48.69450/6.16998&layers=T"
            class="text-green-dark no-underline"
            rel="noopener noreferrer"
            target="_blank">2 rue de l'oratoire, à Nancy</a
          >.
        </p>
        <p class="mb-6">
          Ce site a pour fonction de répondre aux principales questions que vous vous posez sur les
          motifs qui peuvent amener à consulter un psychologue ainsi que sur la manière dont se déroulent
          les consultations.
        </p>
        <p>Si vous avez des questions, n’hésitez pas à me contacter directement.</p>
      </div>
    </main>
    <aside
      class="h-full w-full rounded-lg border border-grey-darkest bg-white pb-6 text-center lg:w-1/3"
    >
      <h2 class="mb-6 bg-green p-6 text-lg font-black">Prendre RDV</h2>
      <h3 class="mb-6 font-black">Par téléphone</h3>
      <p class="mb-6">
        <a href={`tel:${business.phoneE164}`} class="text-green-dark no-underline"
          >{business.phoneDisplay}</a
        >
      </p>
      <h3 class="mb-6 font-black">Par mail</h3>
      <p class="mb-6">
        <a
          href="mailto:florentsimonpsychologue@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-green-dark no-underline">florentsimonpsychologue@gmail.com</a
        >
      </p>
    </aside>
  </div>
</BaseLayout>
