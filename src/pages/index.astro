---
import PrendreRdvPanel from '../components/PrendreRdvPanel.astro';
import { business } from '../data/business';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Florent Simon, psychologue à Nancy';
const description = `Florent Simon, psychologue psychothérapeute à Nancy — enfants, adolescents, adultes. Cabinet ${business.streetAddress}. ${business.phoneDisplay}.`;
---

<BaseLayout title={title} description={description}>
  <div class="flex flex-wrap justify-between">
    <main
      class="custom-home-main mb-2 w-full rounded-lg border border-grey-darkest bg-white p-4 lg:mb-0 lg:w-3/5 lg:p-12"
    >
      <header class="text-center">
        <div class="site-hero mb-10 text-base sm:text-lg md:text-xl">
          <p class="site-hero-name mb-3 text-lg sm:text-xl md:text-2xl">Florent Simon</p>
          <h1
            class="site-hero-h1 site-page-h1 mx-auto max-w-xl text-base leading-snug sm:text-lg md:text-xl"
          >
            Psychologue et psychothérapeute à Nancy
          </h1>
          <p class="site-hero-subtitle mx-auto mt-4 max-w-xl text-sm text-grey-darker sm:text-base">
            Enfants · adolescents · adultes
          </p>
        </div>
      </header>
      <div class="text-center">
        <p class="mb-6">
          Je reçois les enfants, les adolescents et les adultes en consultations psychologiques à mon
          cabinet libéral.
        </p>
        <p class="mb-6">
          Il se situe{' '}
          <a
            href="https://www.openstreetmap.org/?mlat=48.69450&mlon=6.16998#map=17/48.69450/6.16998&layers=T"
            class="text-green-dark no-underline"
            rel="noopener noreferrer"
            target="_blank">2 rue de l'oratoire, à Nancy</a
          >.
        </p>
        <p class="mb-6">
          Ce site a pour fonction de répondre aux principales questions que vous vous posez sur les
          motifs qui peuvent amener à consulter un psychologue ainsi que sur la manière dont se déroulent
          les consultations.
        </p>
        <p>Si vous avez des questions, n’hésitez pas à me contacter directement.</p>
      </div>
    </main>
    <div class="w-full lg:w-1/3">
      <PrendreRdvPanel />
    </div>
  </div>
</BaseLayout>
